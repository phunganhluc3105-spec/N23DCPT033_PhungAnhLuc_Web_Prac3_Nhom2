# Server Port
PORT=5000
NODE_ENV=development

# Allowed CORS origins separated by comma
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas Connection URI (Optional: Leave blank to use local data.json fallback)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blog_db?retryWrites=true&w=majority
